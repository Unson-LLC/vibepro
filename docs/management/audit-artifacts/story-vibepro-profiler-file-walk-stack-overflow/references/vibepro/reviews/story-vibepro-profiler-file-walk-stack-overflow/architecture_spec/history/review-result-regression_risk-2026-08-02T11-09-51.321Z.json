    },
    {
      "severity": "low",
      "id": "artifact-hit-ordering-differs-from-main",
      "detail": "scanner artifact arrays are reordered BFS-vs-DFS; counts, gate_effects, sorted aggregates unchanged; impact limited to artifact diffs against pre-change baselines"
    },
    {
      "severity": "low",
      "id": "deep-tree-recursion-variant-untested",
      "detail": "wide 30k-file fixture catches spread reintroduction but a spread-free deep recursion would pass; acceptable since the iterative rewrite removes both failure modes"
    }
  ],
