      "status": "adjudicated",
      "adjudicated_by": "sato_keigo",
      "adjudicated_at": "2026-07-22"
    },
    {
      "id": "R-003",
      "statement": "budgets.file_line_baseline の13ファイルは凍結行数を超えて成長しない(default 1500行)",
      "status": "adjudicated",
      "adjudicated_by": "sato_keigo",
      "adjudicated_at": "2026-07-22"
    },
    {
      "id": "R-004",
