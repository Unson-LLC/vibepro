{
  "schema_version": "0.1.0",
  "model_version": 2,
  "status": "adjudicated",
  "adjudicated_by": "sato_keigo",
  "adjudicated_at": "2026-07-22",
  "note": "to-beモデルの正本。改訂権限の区分は governance を正とする(旧noteの『自動改訂を禁止』と『rulesの範囲内での機械保守の対象』の同居による解釈揺れは governance の三分法で解消済み)。rules[]は佐藤裁定済み(2026-07-22)の規範。model_version は人間裁定による改訂でのみ増える。",
  "governance": {
    "adjudicated_by": "sato_keigo",
    "adjudicated_at": "2026-08-04",
    "criterion": "その操作がこのモデルの表す規範を緩めうるなら human_adjudicated、緩めえないなら machine_maintainable。人間が承認した裁定結果の反映のみ machine_projection。",
    "machine_maintainable": [
      "既存モジュールへの孤児ファイルの割当 (modules[].paths への追加)",
      "一致ファイルが存在しなくなった paths パターンの除去",
      "rules[] の範囲内での分割詳細の保守 (hotspot優先順位付けによる漸進的な違反解消等)",
      "rebaseline proposal・裁定カードの生成",
      "意味を変えない構造的追加 (既存値を保ったままのフィールド追加)"
    ],
    "human_adjudicated": [
      "rules[] 本文の変更・追加・削除",
      "モジュールの新設・削除・responsibility の変更",
      "allowed_dependencies への新規依存の宣言 (R-004)",
      "budgets.file_line_baseline の引き上げ・default_max_file_lines の変更 (R-003)",
      "scope_roots の変更",
      "status / adjudicated_by の変更"
    ],
    "machine_projection": [
      "人間が承認した裁定結果の target-model への反映",
      "承認された改訂に伴う model_version のインクリメント"
    ],
    "model_version_policy": "model_version は human_adjudicated な改訂が反映されたときにのみ +1 する。machine_maintainable な保守では増やさない。",
    "design_root": "docs/architecture/vibepro-target-model-governance-rebaseline.md"
  },
  "rules": [
    {
      "id": "R-001",
      "statement": "workspace-infra は他のどのモジュールにも依存しない",
      "status": "adjudicated",
      "adjudicated_by": "sato_keigo",
      "adjudicated_at": "2026-07-22"
    },
    {
      "id": "R-002",
